# Configuración de build de producción (Vite lee este archivo en `npm run build`).
#
# Estos tres valores NO son secretos: Vite los inyecta en el bundle JS, que es
# público. La seguridad del flujo OAuth la da PKCE + la lista de callback URLs
# registradas en Cognito, no el ocultamiento del client id.
#
# Los secretos de verdad (claves de API, el client secret de Google) NUNCA van
# acá: van en Environment variables de Amplify y solo del lado del backend.

VITE_COGNITO_USER_POOL_ID=us-east-1_h1uG5pYAS
VITE_COGNITO_CLIENT_ID=76b244eh09k8tto893sqeron6m
VITE_COGNITO_DOMAIN=us-east-1h1ug5pyas.auth.us-east-1.amazoncognito.com

# Toda la API REST entra por API Gateway, que valida el token de Cognito antes
# de reenviar al ALB interno -> ECS -> BFF. Sin esta linea, el fallback de
# `?? 'http://localhost:3010'` queda horneado en el bundle y el navegador del
# usuario intenta llamarse a si mismo (ademas de bloquearse por mixed content,
# porque la pagina es https y el fallback es http).
VITE_BFF_URL=https://asn2mkqp01.execute-api.us-east-1.amazonaws.com

# El chat agentico tambien entra por API Gateway (ruta ANY /chat/{proxy+} ->
# mismo ALB, que rutea /chat/* al workflow por path). Sin esta linea el
# fallback `?? ''` deja el chat en same-origin, y en el dominio de Amplify
# no existe /chat. Solo funciona porque el front ya migro de SSE a polling:
# API Gateway corta cualquier respuesta a los 30s.
VITE_CHAT_API_URL=https://asn2mkqp01.execute-api.us-east-1.amazonaws.com
